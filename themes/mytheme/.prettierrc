{
  "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-silverstripe"],
  "tailwindConfig": "./tailwind.config.js",
  "overrides": [
    {
      "files": "*.ss",
      "options": {
        "parser": "silverstripe",
        "printWidth": 120,
        "htmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}
